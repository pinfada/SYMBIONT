{
  "name": "symbiont",
  "version": "1.0.0",
  "description": "Système d'intégration neural pour la gestion des composants",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:workers && webpack --config webpack.background.js && webpack --config webpack.config.js",
    "build:workers": "webpack --config webpack.workers.js",
    "build:main": "webpack --config webpack.config.js",
    "build:background": "webpack --config webpack.background.js",
    "build:full": "npm run build && npm run check-manifest",
    "build:firefox": "npm run build:workers && webpack --config webpack.background.js --env browser=firefox && webpack --config webpack.config.js --env browser=firefox",
    "lint:firefox": "web-ext lint --source-dir dist --self-hosted --ignore-files webllm/index.js",
    "setup:firefox-profile": "node scripts/firefox-dev-profile.js",
    "run:firefox": "npm run setup:firefox-profile && web-ext run --source-dir dist --target firefox-desktop --firefox-profile symbiont-dev --keep-profile-changes",
    "dev:firefox": "concurrently -k \"npm run build:workers -- --watch\" \"webpack --config webpack.background.js --env browser=firefox --watch\" \"webpack --config webpack.config.js --env browser=firefox --watch\" \"npm run run:firefox\"",
    "package:firefox": "npm run build:firefox && npm run lint:firefox && npm run xpi:firefox",
    "xpi:firefox": "web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest --ignore-files \"**/*.map\" \"**/*.d.ts\" --filename \"symbiont-{version}.xpi\"",
    "sign:firefox": "npm run build:firefox && npm run lint:firefox && web-ext sign --source-dir dist --channel unlisted --artifacts-dir web-ext-artifacts --ignore-files \"**/*.map\" \"**/*.d.ts\"",
    "build:all": "npm run build:full && cd backend && npm run build",
    "build:production": "NODE_ENV=production npm run build:full",
    "test": "jest",
    "test:ci": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e": "playwright test",
    "test:e2e": "playwright test",
    "test:validate": "node scripts/validate-tests.js",
    "test:e2e:serve": "concurrently -k -s first \"npm:serve:dist\" \"wait-on http://localhost:8080/popup.html && npx playwright test\"",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "start": "node dist/index.js",
    "dev": "concurrently \"npm run build:workers -- --watch\" \"webpack --config webpack.config.js --watch\"",
    "check-manifest": "node scripts/check-manifest.js",
    "serve:dist": "npx serve -l 8080 dist",
    "build:css": "postcss src/popup/index.css -o dist/popup/index.css",
    "analyze": "webpack-bundle-analyzer dist/popup/index.js",
    "clean": "rimraf dist coverage .nyc_output",
    "prepack": "npm run build:production"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.46",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.0.323",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "autoprefixer": "^10.4.21",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^7.6.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "^13.0.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright": "^1.52.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^10.1.0",
    "postcss-loader": "^7.3.3",
    "postcss-prefix-selector": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "sharp": "^0.35.3",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.1.8",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.2",
    "typescript": "^5.3.3",
    "wait-on": "^8.0.4",
    "web-ext": "^10.5.0",
    "webpack": "^5.99.9",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "uuid": "^11.1.0"
  }
}
