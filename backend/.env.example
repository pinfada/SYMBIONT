# SYMBIONT Backend — variables d'environnement requises

# PostgreSQL (obligatoire)
DATABASE_URL=postgresql://user:password@localhost:5432/symbiont_dev

# Secrets JWT (obligatoires, minimum 64 caractères cryptographiquement sûrs)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Serveur
PORT=3001
NODE_ENV=development
VERSION=1.0.0

# Redis (optionnel — cache désactivé si absent)
# REDIS_URL=redis://localhost:6379

# Seed initial (optionnel — utilisé par `npm run seed`)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-please
# SEED_ADMIN_USERNAME=admin
